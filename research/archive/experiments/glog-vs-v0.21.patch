+ movbu (xb_gt),d0
+ cmp 0,d0
+ beq 8f
+ movbu (xb_gk),d1
+ cmp 11,d1
+ bne 8f
+ mov (48,a2),d1
+ cmp 12,d1
+ bne 8f
+ mov (4,a2),a1
+ movhu (14,a1),d1
