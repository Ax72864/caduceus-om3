+ add -1,d0
+ cmp HMAX,d0
+ bcc 9f
+ btst 3,d0
+ bne 9f
+ mov d0,a1
+ add POOL,a1
+ mov (a1),d0
+ cmp MAGIC,d0
+ bne 9f
+ retf [],0
