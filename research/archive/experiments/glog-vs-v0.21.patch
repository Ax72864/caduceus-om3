--- base/firmware/src/xblock_gd1.s	1969-12-31 16:00:00.000000000 -0800
+++ glog/firmware/src/xblock_gd1.s	2026-11-07 10:00:21.720809031 -0800
@@ -0,0 +1,1125 @@
+/* Caduceus for OM-3 v0.20 test 5: the Extras code block (appended to GUIDES.BIN, our own code).
+ *
+ * Runs from its heap buffer (uncached pool, as the camera's malloc returns), relocated in place by entry 0. Linked at
+ * XB_LINK; the build links it twice and lists every 32-bit field that moves (absolute: + delta, PC-relative to the
+ * firmware: - delta). Entries are 8 bytes apart and reached from the firmware stubs with every register as the stub
+ * documents. Slot entry S = P + 32 + 64k of the effective COLOR profile k+1: +49 Glow (-1..-5) / Clarity (+1..+5),
+ * +50 Art Effect id (Caduceus: 1 Star Light, 2 Pin Hole, 4 White Edge, 5 Frame), +51 NR (1 Std, 2 Low, 3 Off), +52 VigFix (1: Shading Comp. reads Off).
+ * Stores: the job flag word in the stock params / request (as the stock Art Effect code), own stack, the relocation
+ * fields of this block (entry 0, once, before the block is published). No mul/div (MDR is the weight getter's return).
+ */
+ .am33_2
+ .text
+ .global _start
+_start:
+xb_base:
+ jmp xb_reloc                     /* +0  relocate (called once by x_load: `calls`) */
+ .balign 8
+ jmp xb_cap                       /* +8  capture flags (s_cap) */
+ .balign 8
+ jmp xb_lv                        /* +16 live-view / movie request flags (s_lv) */
+ .balign 8
+ jmp xb_wt                        /* +24 Soft Focus weight (s_wt) */
+ .balign 8
+ jmp xb_nr                        /* +32 stills Noise Filter / Shading Comp. read (s_nr) */
+ .balign 8
+ jmp xb_kad                       /* +40 editor ALL state read (k_ad) */
+ .balign 8
+ jmp xb_vl                        /* +48 dial label of the Extras slice (vl_s) */
+ .balign 8
+ jmp xb_gs                        /* +56 grain: Soft Focus blend setup wrapper (g_sf) */
+ .balign 8
+xb_nrel:
+ .long 0                          /* relocation count (written by the build) */
+
+/* xb_slot: `call xb_slot,[d2,d3],12` -> a1 = slot entry S of the effective COLOR1..4 profile, or 0. Uses d0, d1, a0. */
+xb_slot:
+ mov 63153,d0
+ clr d1
+ mov 0,a0
+ call getter,[d2,d3],12
+ extbu d0
+ add -1,d0
+ cmp 4,d0
+ bcc 9f
+ mov d0,d2
+ movhu (STATE),d0
+ add -1,d0
+ cmp HMAX,d0
+ bcc 9f
+ btst 3,d0
+ bne 9f
+ mov d0,a1
+ add POOL,a1
+ mov (a1),d0
+ cmp MAGIC,d0
+ bne 9f
+ asl 6,d2
+ add d2,a1
+ add 32,a1
+ ret [d2,d3],12
+9:
+ mov 0,a1
+ ret [d2,d3],12
+
+/* xb_art: d1 |= the job flags of S's Art Effect (a1 = S). Uses d0, a0; returns through MDR. */
+xb_art:
+ movbu (50,a1),d0
+ cmp 6,d0
+ bcc 1f
+ add d0,d0
+ mov xb_ft,a0
+ movhu (d0,a0),d0
+ or d0,d1
+1:
+ retf [],0
+
+/* capture (Art Effect -> flag converter 0x60555e47): a3 = capture, a2 = params+12 (flags), (-4,a2) = key.
+ * Exit as stock: fx_back with d0 = the Art Effect id and a1 = its address, or fx_tail. */
+xb_cap:
+ mov 38225,a1
+ add a3,a1
+ movbu (a1),d0
+ cmp 0,d0
+ bne 8f                           /* the camera's own Art Effect: stock */
+ mov (-4,a2),d0
+ cmp 0x000b0000,d0                /* key bytes 0, 0, halfword 11: COLOR */
+ bne 7f
+ call xb_slot,[d2,d3],12
+ cmp 0,a1
+ beq 7f
+ mov (a2),d1
+ movbu (49,a1),d0
+ movbu (53,a1),a0
+ cmp 0,a0
+ bne 2f
+ cmp 0,d0
+ beq 1f
+2:
+ or 128,d1                        /* Glow / Clarity or Grain: the Soft Focus passes (the weight decides which) */
+1:
+ call xb_art,[],0
+ mov d1,(a2)
+ jmp fx_tail
+7:
+ clr d0
+8:
+ jmp fx_back
+
+/* live view / movie (record -> development request 0x6046b86c, COLOR, the stock Art Effect gates passed):
+ * a2 = request (+12 flags), a3 = record+248, d3 live. Glow only (Clarity is invisible on combiner 12, as Caduceus). */
+xb_lv:
+ call xb_slot,[d2,d3],12
+ cmp 0,a1
+ beq 9f
+ mov (12,a2),d1
+ movbu (49,a1),d0
+ btst 0x80,d0
+ beq 1f
+ or 128,d1
+1:
+ call xb_art,[],0
+ mov d1,(12,a2)
+9:
+ jmp lv_skip
+
+/* Soft Focus weight (getter 0x605048c1, entered `call ...,[],0`): MDR = return (0x60504edb combiner 11, stills;
+ * 0x60504f23 combiner 12), a0 = context, key 11 checked. d0 = w (Q10 weight of the sharp input); stock key 11: 600. */
+xb_wt:
+ mov mdr,d1
+ add -8,sp
+ mov d1,(4,sp)
+ call xb_slot,[d2,d3],12
+ mov 600,d0
+ cmp 0,a1
+ beq 8f
+ movbu (49,a1),d1
+ extb d1
+ cmp 0,d1
+ bne 1f
+ movbu (53,a1),d1                 /* no Glow / Clarity: Grain alone -> w 1024, the sharp image unchanged */
+ cmp 0,d1
+ beq 8f
+ mov 1024,d0
+ bra 8f
+1:
+ blt 5f
+ cmp 6,d1                         /* Clarity 1..5 */
+ bcc 8f
+ mov 1024,d0                      /* combiner 12 (live view classes): no negative gain */
+ mov (4,sp),a0
+ cmp c11_ret,a0
+ bne 8f
+ add -1,d1
+ add d1,d1
+ mov xb_cl,a0
+ movhu (d1,a0),d0
+ bra 8f
+5:
+ clr d0
+ sub d1,d0                        /* Glow 1..5 */
+ cmp 6,d0
+ bcc 7f
+ add -1,d0
+ add d0,d0
+ mov xb_gl,a0
+ movhu (d0,a0),d0
+ bra 8f
+7:
+ mov 600,d0
+8:
+ mov (4,sp),d1
+ add 8,sp
+ mov d1,mdr
+ retf [],0
+
+/* property reads (s_nr): the site's `call getter,[d2,d3],12` frame, d0 key, d1, a0 as for the getter. Key 0x9719
+ * (stills Noise Filter; capture and Exif sites): NR 1..3 -> the real read, then d0 = 0 Standard / -1 Low / -2 Off.
+ * Key 0x8c21 (Shading Comp., sid 61; capture and lens-request sites, v0.21): VigFix 1 -> the real read, then d0 = 0
+ * (Off, a stock value). Otherwise the getter as stock. */
+xb_nr:
+ mov d1,d2
+ mov a0,d3
+ add -8,sp                        /* (0) call slot, (4) the key */
+ mov d0,(4,sp)
+ call xb_slot,[d2,d3],12
+ mov (4,sp),d1                    /* d1 = key */
+ add 8,sp
+ cmp 0,a1
+ beq 9f
+ cmp 38681,d1
+ bne 5f
+ movbu (51,a1),d0                 /* NR 1..3 */
+ add -1,d0
+ cmp 3,d0
+ bcc 9f
+ mov xb_nm,a1
+ movbu (d0,a1),d0
+ extb d0
+ bra 6f
+5:
+ movbu (52,a1),d0                 /* v0.21 VigFix 1: Shading Comp. reads 0 (Off) */
+ cmp 1,d0
+ bne 9f
+ clr d0
+6:
+ mov d1,a1                        /* key */
+ mov d2,d1
+ mov d3,a0
+ mov d0,d2                        /* the value to return */
+ mov a1,d0
+ call getter,[d2,d3],12
+ mov d2,d0
+ ret [d2,d3],12
+9:
+ mov d1,d0
+ mov d2,d1
+ mov d3,a0
+ jmp getter
+
+/* editor ALL state (k_ad, `call k_ad,[a2],8` frame, a stub jump): (24,sp) <- GetValue(2201 + k), and when that is not
+ * 255, GetValue(2197 + k); (20,sp) = 2197 + k. As k_cur: keeps d2/d3/a3, returns through the frame. */
+xb_kad:
+ call facade,[],4
+ mov (a0),a2
+ mov (12,a2),a2
+ mov sp,a1
+ add 24,a1
+ clr d0
+ mov d0,(a1)
+ mov (20,sp),d0
+ add 4,d0
+ calls (a2)
+ mov (24,sp),d0
+ cmp 255,d0
+ beq 9f
+ call facade,[],4
+ mov (a0),a2
+ mov (12,a2),a2
+ mov sp,a1
+ add 24,a1
+ mov (20,sp),d0
+ calls (a2)
+9:
+ ret [a2],8
+
+/* ---- grain (v0.21 grain test 1). The Soft Focus blend setup 0x604be2aa returns with its output, the new
+ * buffer 0x1000 (YCbYCr 4:2:2, Y in the even bytes, 2 B/px, rows memHw x 2 B apart), complete in memory (camera
+ * probe g2: a pattern written there after the setup is in the JPEG). On a COLOR1-4 still whose look has Grain 1..5
+ * (slot +53), every Y byte becomes T[Y][h]: h a 16-level noise row (xb_p1: xorshift32, triangular, vertical IIR,
+ * horizontal pair), T = clamp(Y + (((128 h - 943) G[Y] S + 2^17) >> 18)) with G midtone-weighted and S from xb_gstab.
+ * The image is reached through this CPU's bus window, one row at a time under the firmware's lock (xb_open), and
+ * the cache is flushed at the end. Work buffer: one malloc (T 4096 B, V and H one row each), freed again.
+ * grain/model.py is the same computation in Python. Stores: the image's Y bytes, the work buffer, xb_seed. */
+xb_p:                             /* leaf: a1 = P or 0. Uses d0 */
+ movhu (STATE),d0
+ add -1,d0
+ cmp HMAX,d0
+ bcc 9f
+ btst 3,d0
+ bne 9f
+ mov d0,a1
+ add POOL,a1
+ mov (a1),d0
+ cmp MAGIC,d0
+ bne 9f
+ retf [],0
+9:
+ mov 0,a1
+ retf [],0
+
+xb_open:                          /* `call xb_open,[d2,d3,a2,a3],28`, d0 = bus address, d1 = length -> a0 = CPU address or 0,
+                                     d0 = lock token (the lock is held: close it with xb_close), d1 = 1 window / 0.
+                                     Bus 0xa0000000..0xb7ffffff is the DRAM the CPU sees uncached at the same address;
+                                     anything else from 0x08000000 goes through this CPU's bus window (the firmware's
+                                     own mapper, under the firmware's lock: no task switch, interrupts masked) when the
+                                     d1 bytes stay inside the window's 128 MB. */
+ mov d0,a3
+ mov d1,d3
+ clr d0
+ call LOCK,[d2],8
+ mov d0,a2                        /* token */
+ clr d2
+ mov a3,d0
+ cmp 0x08000000,d0
+ bcs 7f
+ cmp 0xa0000000,d0
+ bcs 3f
+ cmp 0xb8000000,d0
+ bcc 3f
+ mov a3,a0                        /* main DRAM: direct */
+ bra 8f
+3:
+ and 0x07ffffff,d0
+ add d3,d0
+ cmp 0x08000001,d0
+ bcc 7f
+ mov a3,a0
+ call WINMAP,[d2,d3,a2,a3],28
+ mov 1,d2
+ bra 8f
+7:
+ mov 0,a0
+8:
+ mov a2,d0
+ mov d2,d1
+ ret [d2,d3,a2,a3],28
+
+xb_close:                         /* `call xb_close,[d2],8`, d0 = token */
+ call UNLOCK,[d2],8
+ ret [d2],8
+
+xb_rec:                           /* `call xb_rec,[d2,d3],12`, a0 = job -> a1 = record of buffer 0x1000, or 0 */
+ mov a0,d3
+ mov 4096,d0
+ call BUFIDX,[d2,d3],8
+ exthu d0
+ cmp 48,d0
+ bcc 9f
+ mov d0,d1
+ asl 3,d1                         /* 8 i */
+ mov d1,d2
+ asl 2,d2                         /* 32 i */
+ add d2,d1                        /* 40 i */
+ asl 1,d2                         /* 64 i */
+ add d2,d1                        /* 104 i */
+ mov d3,a0
+ mov (10276,a0),a1
+ add d1,a1
+ ret [d2,d3],12
+9:
+ mov 0,a1
+ ret [d2,d3],12
+
+
+ .set P_DIRTY, 685
+ .set P_LPTR, 708
+ .set USCLK, 0x98900284           /* DIAG: the microsecond free-run counter (timer channel 33) */
+xb_gs:                            /* `calls` (0,sp) = return, a0 = job */
+ movm [d2,d3,a2,a3],(sp)
+ add -16,sp                       /* (0) call slot, (4) job, (8) level, (12) result */
+ mov a0,(4,sp)
+ call xb_slot,[d2,d3],12
+ cmp 0,a1
+ beq 90f
+ movbu (53,a1),d0
+ add -1,d0
+ cmp 5,d0
+ bcs 10f
+90:                               /* no grain: the stock setup, as if called directly */
+ mov (4,sp),a0
+ add 16,sp
+ movm (sp),[d2,d3,a2,a3]
+ jmp SF_ENT
+10:
+ inc d0
+ mov d0,(8,sp)
+ mov (4,sp),a0
+ mov SF_ENT,a1
+ calls (a1)
+ mov d0,(12,sp)
+ cmp 0,d0
+ bne 20f
+ mov (4,sp),a0
+ call xb_rec,[d2,d3],12
+ cmp 0,a1
+ beq 20f
+ mov a1,a0
+ mov (8,sp),d0
+ call xb_grain,[d2,d3,a2,a3],80
+20:
+ mov (12,sp),d0
+ ret [d2,d3,a2,a3],32
+
+/* xb_grain: `call xb_grain,[d2,d3,a2,a3],80` (64 B of locals below the saved registers), a0 = buffer record, d0 = level 1..5. Locals: (0) call slot, (4) rec,
+ * (8) S, (12) work, (16) row, (20) bus, (24) pitch, (28) words per row, (32) groups of 4 px, (36) r, (40) token,
+ * (44) Hw, (48) Vw */
+xb_grain:
+ mov a0,(4,sp)
+ mov d0,(52,sp)                   /* DIAG: mode = level */
+ mov (USCLK),d1
+ mov d1,(56,sp)                   /* DIAG: start time */
+ mov 90,d0
+ mov d0,(8,sp)
+ movhu (16,a0),d0                 /* format 0x0c02 only */
+ cmp 0x0c02,d0
+ bne 99f
+ mov (4,a0),d0                    /* 32-bit bus address */
+ cmp 0,d0
+ bne 99f
+ movhu (20,a0),d0                 /* Hw: 4 .. 8192, a multiple of 4 */
+ mov d0,(44,sp)
+ cmp 4,d0
+ bcs 99f
+ cmp 8193,d0
+ bcc 99f
+ btst 3,d0
+ bne 99f
+ movhu (18,a0),d1                 /* memHw >= Hw */
+ cmp d0,d1
+ bcs 99f
+ add d1,d1
+ mov d1,(24,sp)
+ movhu (22,a0),d1
+ mov d1,(48,sp)
+ cmp 0,d1
+ beq 99f
+ mov d0,d1
+ lsr 1,d1
+ mov d1,(28,sp)
+ lsr 1,d1
+ mov d1,(32,sp)
+ mov (a0),d1
+ mov d1,(20,sp)
+ add d0,d0
+ add 4096,d0
+ call malloc,[],4
+ cmp 0,a0
+ beq 99f
+ mov a0,(12,sp)
+ mov (8,sp),d3                    /* T */
+ mov xb_G,a1
+ call xb_tbl,[d2,d3,a2,a3],16
+ mov (52,sp),d0                   /* DIAG mode 1: buffer + table only */
+ cmp 1,d0
+ beq 5f
+ mov (12,sp),a0                   /* V = 15 */
+ add 4096,a0
+ mov (44,sp),d1
+ mov 15,d0
+1:
+ movbu d0,(a0)
+ inc a0
+ add -1,d1
+ bne 1b
+ mov xb_seed,a0
+ mov (a0),d0
+ cmp 0,d0
+ bne 2f
+ mov 0x12345678,d0
+2:
+ mov d0,(36,sp)
+ clr d0
+ mov d0,(16,sp)
+3:                                /* row loop */
+ mov (12,sp),a0
+ add 4096,a0                      /* V */
+ mov a0,a1
+ mov (44,sp),d0
+ add d0,a1                        /* H */
+ mov (32,sp),a2
+ mov (36,sp),a3
+ call xb_p1,[],0
+ mov a3,(36,sp)
+ mov (52,sp),d1                   /* DIAG: rows grained: mode 2 none, 3 64, 4 512, 5 all */
+ mov (16,sp),d0
+ cmp 2,d1
+ beq 6f
+ cmp 3,d1
+ bne 7f
+ cmp 64,d0
+ bcc 6f
+7:
+ cmp 4,d1
+ bne 8f
+ cmp 512,d0
+ bcc 6f
+8:
+ mov (16,sp),d0
+ mov (24,sp),d1
+ mul d1,d0
+ mov (20,sp),d1
+ add d1,d0                        /* the row's bus address */
+ mov (44,sp),d1
+ add d1,d1                        /* its length */
+ call xb_open,[d2,d3,a2,a3],28
+ mov d0,(40,sp)
+ cmp 0,a0
+ beq 4f                           /* a row across the window's edge (at most one): left as it is */
+ mov (12,sp),a3                   /* T */
+ mov a3,a1
+ add 4096,a1
+ mov (44,sp),d0
+ add d0,a1                        /* H */
+ mov (28,sp),a2
+ call xb_p2,[],0
+4:
+ mov (40,sp),d0
+ call xb_close,[d2],8
+6:
+ mov (16,sp),d0
+ inc d0
+ mov d0,(16,sp)
+ mov (48,sp),d1
