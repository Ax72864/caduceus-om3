+xb_lv:
+ call xb_slot,[d2,d3],12
+ cmp 0,a1
+ beq 9f
+ mov (12,a2),d1
+ movbu (49,a1),d0
+ btst 0x80,d0
+ beq 1f
+ or 128,d1
+1:
+ call xb_art,[],0
+ mov d1,(12,a2)
