+
+/* xb_k3g (gl10 TEST): `call xb_k3g,[d2,d3,a2,a3],20`, a2 = context. A COLOR capture with Grain (xb_gt, xb_gk 11):
+ * the kind-3 request with +14 0x1000, effect +1084 0 and stage 1: 0xf005 / 2: 0xf005 / 3: 0 (final) gets key 12
+ * (request +10 and context +48) and grain 3 at +1079; level 2 also +1091 = 0xa0. Uses d0, d1, a0, a1. */
+xb_k3g:
+ movbu (xb_gt),d0
+ cmp 0,d0
+ beq 9f
+ cmp 4,d0
+ bcc 9f
+ movbu (xb_gk),d1
+ cmp 11,d1
+ bne 9f
+ mov (4,a2),a1
+ cmp 0,a1
+ beq 9f
+ movbu (16,a1),d1
+ cmp 3,d1
+ bne 9f
+ movhu (14,a1),d1
+ cmp 0x1000,d1
+ bne 9f
+ movhu (1084,a1),d1
+ cmp 0,d1
+ bne 9f
+ movbu (10,a1),d1
+ cmp 11,d1
+ bne 9f
+ movhu (12,a1),d1
+ cmp 3,d0
+ beq 3f
+ cmp 0xf005,d1
+ bne 9f
+ bra 4f
+3:
+ cmp 0,d1
+ bne 9f
+4:
+ mov 3,d1
+ movbu d1,(1079,a1)
+ cmp 2,d0
+ bne 5f
+ mov 0xa0,d1
+ movbu d1,(1091,a1)
+5:
+ mov 12,d1
+ movbu d1,(10,a1)
+ mov d1,(48,a2)
+9:
+ ret [d2,d3,a2,a3],20
