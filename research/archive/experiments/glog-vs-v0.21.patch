+ asl 8,d0
+ movbu (a0),d1
+ or d1,d0
+ mov a1,d1
+ add d1,d0
+ movbu d0,(a0)
+ lsr 8,d0
+ movbu d0,(1,a0)
+ lsr 8,d0
+ movbu d0,(2,a0)
+ lsr 8,d0
+ movbu d0,(3,a0)
+ add 4,a3
+ add -1,d2
+ bra 2b
+4:
+ call xb_lbl,[d2,d3,a2,a3],24     /* relocated: absolute addresses and firmware calls are live now */
+ mov a2,d0
+ movm (sp),[d2,d3,a2,a3]
+ rets
