+ * 0x02..) >> 2) & 0x3f..; no byte carries (bytes <= 62). Same values as grain/model.py. Uses d0..d3, a0..a3. */
+xb_p1s:
+ mov (64,sp),a0
+ mov (68,sp),a1
+ mov (72,sp),a2
+ mov 0x0f000000,d3                /* the previous word's v: 15 in byte 3 */
+1:
+ mov (76,sp),d0                   /* xorshift32 */
+ mov d0,d2
+ asl 13,d2
+ xor d2,d0
+ mov d0,d2
+ lsr 17,d2
+ xor d2,d0
+ mov d0,d2
+ asl 5,d2
+ xor d2,d0
+ mov d0,(76,sp)
+ mov d0,d1
+ lsr 4,d1
+ and 0x0f0f0f0f,d0
+ and 0x0f0f0f0f,d1
+ add d1,d0                        /* n */
+ mov (a0),d1                      /* V */
+ mov d1,d2
+ and d0,d2                        /* V & n */
+ xor d0,d1
+ and 0xfefefefe,d1
+ lsr 1,d1
+ add d2,d1                        /* v */
+ mov d1,(a0)
+ add 4,a0
+ lsr 24,d3
+ mov d1,d2
+ asl 8,d2
+ or d3,d2                         /* v_left */
+ mov d1,d3                        /* (the next word's previous) */
+ add d1,d2
+ add 0x02020202,d2
+ lsr 2,d2
+ and 0x3f3f3f3f,d2                /* h */
+ mov d2,(a1)
+ add 4,a1
+ add -1,a2
+ cmp 0,a2
+ bne 1b
+ rets
+
+/* xb_p2s: `calls (a0)` from xb_grain: the row (80,sp), H (68), words (84), T (88). Y0, Y1 of each word -> T[Y][h].
+ * Uses d0..d3, a0..a3. */
+xb_p2s:
+ mov (80,sp),a0
+ mov (68,sp),a1
+ mov (84,sp),a2
+ mov (88,sp),a3
+1:
+ mov (a0),d0
+ mov d0,d1
+ and 0xff,d1
+ asl 4,d1
+ movbu (a1),d2
+ or d2,d1
+ movbu (d1,a3),d1                 /* Y0' */
+ mov d0,d2
+ lsr 16,d2
+ and 0xff,d2
+ asl 4,d2
+ movbu (1,a1),d3
+ or d3,d2
+ movbu (d2,a3),d2                 /* Y1' */
+ and 0xff00ff00,d0
+ or d1,d0
+ asl 16,d2
+ or d2,d0
+ mov d0,(a0)
+ add 4,a0
+ add 2,a1
+ add -1,a2
+ cmp 0,a2
+ bne 1b
+ rets
+
+ .balign 4
+xb_seed:
+ .long 0
+
+/* entry 0 (`calls`): relocate this block in place -> d0 = its address. Keeps d2, d3, a2, a3. */
+xb_reloc:                         /* a2 = P (x_load) */
+ add -4,sp
+ call 1f,[],0                     /* MDR = the address of 1 (the call word goes to the new slot) */
+1:
+ mov mdr,d0
+ add 4,sp
+ add xb_base-1b,d0                /* d0 = the block's address */
+ mov d0,a0
+ add xb_pp-xb_base,a0
+ mov a2,(a0)                      /* P, for the label loader */
+ movm [d2,d3,a2,a3],(sp)
+ mov d0,a2
+ mov d0,d3
+ add -XB_LINK,d3                  /* delta */
+ mov a2,a3
+ add xb_end-xb_base,a3            /* the relocation list */
+ mov a2,a0
+ add xb_nrel-xb_base,a0
+ mov (a0),d2
+2:
+ cmp 0,d2
+ beq 4f
+ mov (a3),d1
+ mov d1,d0
+ and 0x7fffffff,d0
+ mov a2,a0
+ add d0,a0                        /* the field (any alignment: byte access) */
+ mov d3,a1                        /* bit 31 set: absolute, + delta */
+ cmp 0,d1
+ blt 3f
+ clr d0                           /* else PC-relative to the firmware: - delta */
+ sub d3,d0
+ mov d0,a1
+3:
+ movbu (3,a0),d0
+ asl 8,d0
+ movbu (2,a0),d1
+ or d1,d0
+ asl 8,d0
+ movbu (1,a0),d1
+ or d1,d0
+ asl 8,d0
+ movbu (a0),d1
+ or d1,d0
+ mov a1,d1
+ add d1,d0
+ movbu d0,(a0)
+ lsr 8,d0
+ movbu d0,(1,a0)
+ lsr 8,d0
+ movbu d0,(2,a0)
+ lsr 8,d0
+ movbu d0,(3,a0)
+ add 4,a3
+ add -1,d2
+ bra 2b
+4:
+ call xb_lbl,[d2,d3,a2,a3],24     /* relocated: absolute addresses and firmware calls are live now */
+ mov a2,d0
+ movm (sp),[d2,d3,a2,a3]
+ rets
+
+/* ---- dial labels: OM3MOD/LABELS.BIN v2 = 'OM3V' | u32 total | u32 CRC-32 of bytes 12.. | u32 n (21) | n bitmaps
+ * 30 rows x 9 bytes (70 px, MSB first, 1 = letter fill). One heap copy (XL_FILE B) and one 2 KB stream buffer; the
+ * label is drawn and encoded (OSD type 11, 70 x 30) only when it changes. */
+ .set XL_N, 24
+ .set XL_BM, 270
+ .set XL_FILE, 16+XL_N*XL_BM
+ .set XL_OUT, 2048
+/* xb_lbl: `call xb_lbl,[d2,d3,a2,a3],24` once, after relocation. Locals (4) handle, (8) file buffer. Stores: xb_lb,
+ * xb_lo, xb_lc (this block), the heap buffers, own frame. Anything wrong: no labels (xb_lb = 0). */
+xb_lbl:
+ mov xb_lpath,a0
+ mov gd_mode,a1
+ call fopen,[],4
+ cmp 0,a0
+ beq 9f
+ mov a0,(4,sp)
+ mov XL_FILE+4,d0
+ call malloc,[],4
+ cmp 0,a0
+ beq 8f
+ mov a0,(8,sp)
+ mov 1,d0
+ mov XL_FILE+4,d1                 /* one more than the file: a longer file is refused */
+ mov (4,sp),a1
+ call fread,[d2,d3,a2,a3],24
+ cmp XL_FILE,d0
+ bne 8f
+ mov (8,sp),a2
+ mov (a2),d0
+ cmp 0x56334d4f,d0                /* 'OM3V' */
+ bne 8f
+ mov (4,a2),d0
+ cmp XL_FILE,d0
+ bne 8f
+ mov (12,a2),d0
+ cmp XL_N,d0
+ bne 8f
+ mov -1,d0
+ mov a2,a0
+ add 12,a0
+ mov XL_FILE-12,d1
+ call sd_crc,[d2,d3],12
+ not d0
+ mov (8,a2),d1
+ cmp d1,d0
+ bne 8f
+ mov XL_OUT,d0
+ call malloc,[],4
+ cmp 0,a0
+ beq 8f
+ mov xb_lo,a1
+ mov a0,(a1)
+ mov -1,d0
+ mov xb_lc,a1
+ mov d0,(a1)                      /* nothing drawn yet */
+ mov xb_lb,a1
+ mov a2,(a1)                      /* published last */
+8:
+ mov (4,sp),a0
+ call fclose,[d2,a2,a3],16
+9:
+ ret [d2,d3,a2,a3],24
+
+/* xb_px: `call xb_px,[],0`, d1 = x, d2 = y (any value), a3 = bitmap -> d0 = 1 letter fill, else 0. Uses d3, a0. */
+xb_px:
+ cmp 70,d1
+ bcc 9f
+ cmp 30,d2
+ bcc 9f
+ mov d2,d0
+ asl 3,d0
+ add d2,d0                        /* 9y */
+ mov a3,a0
+ add d0,a0
+ mov d1,d0
+ lsr 3,d0
+ add d0,a0
+ movbu (a0),d0
+ mov d1,d3
+ and 7,d3
+ asl d3,d0
+ and 128,d0
+ lsr 7,d0
+ retf [],0
+9:
+ clr d0
+ retf [],0
+
+/* xb_rend: `call xb_rend,[d2,d3,a2,a3],64`, d0 = label -> d0 = stream length in xb_lo. Locals: (4) x, (8) y, (12) out,
+ * (16) bit buffer, (20) bits in it, (24) tokens in the word, (28) value, (32) run, (36) out end. */
+ .macro XB_TOK                    /* d0 = token -> the stream (12 bits; after 5 tokens 4 zero bits) */
+ mov (20,sp),d1
+ asl d1,d0
+ mov (16,sp),d2
+ or d0,d2
+ add 12,d1
+ mov (24,sp),d0
+ inc d0
+ cmp 5,d0
+ bne 1f
+ clr d0
+ add 4,d1
+1:
+ mov d0,(24,sp)
+ mov (12,sp),a0
+2:
+ cmp 8,d1
+ bcs 3f
+ mov (36,sp),d0
+ cmp d0,a0
+ bcc 3f                           /* never past the buffer */
+ movbu d2,(a0)
+ inc a0
+ lsr 8,d2
+ add -8,d1
+ bra 2b
+3:
+ mov a0,(12,sp)
+ mov d2,(16,sp)
+ mov d1,(20,sp)
+ .endm
+xb_rend:
+ mov xb_lb,a0
+ mov (a0),a3
+ add 16,a3
+ cmp 0,d0
+ beq 2f
+1:
+ add XL_BM,a3
+ add -1,d0
+ bne 1b
+2:
+ mov xb_lo,a0
+ mov (a0),a0
+ mov a0,d0
+ add XL_OUT,d0
+ mov d0,(36,sp)
+ mov 0x0b04501d,d0                /* stream header: 70 x 30, type 11 */
+ mov d0,(a0)
+ add 4,a0
+ mov a0,(12,sp)
+ clr d0
+ mov d0,(16,sp)
+ mov d0,(20,sp)
+ mov d0,(24,sp)
+ mov d0,(32,sp)
+ mov d0,(8,sp)
+10:
+ clr d0
+ mov d0,(4,sp)
+11:
+ mov (4,sp),d1                    /* class of (x, y) */
+ mov (8,sp),d2
+ call xb_px,[],0
+ mov 10,a2
+ cmp 0,d0
+ bne 15f
+ mov -1,a1                        /* 8 neighbours: dark edge 7 */
+12:
+ mov -1,a2
+13:
+ mov (4,sp),d1
+ mov a2,d0
+ add d0,d1
+ mov (8,sp),d2
+ mov a1,d0
+ add d0,d2
+ call xb_px,[],0
+ cmp 0,d0
+ bne 14f
+ inc a2
+ cmp 2,a2
+ bne 13b
+ inc a1
+ cmp 2,a1
+ bne 12b
+ mov -2,a1                        /* out to 2 px: grey 8 */
+16:
+ mov -2,a2
+17:
+ mov (4,sp),d1
+ mov a2,d0
+ add d0,d1
+ mov (8,sp),d2
+ mov a1,d0
+ add d0,d2
+ call xb_px,[],0
+ cmp 0,d0
+ bne 18f
+ inc a2
+ cmp 3,a2
+ bne 17b
+ inc a1
+ cmp 3,a1
+ bne 16b
+ mov 0,a2
+ bra 15f
+14:
+ mov 7,a2
+ bra 15f
+18:
+ mov 8,a2
+15:
+ mov a2,d0                        /* d0 = the class; extend the run or emit it */
+ mov (32,sp),d1
+ cmp 0,d1
+ beq 19f
+ mov (28,sp),d2
+ cmp d2,d0
+ bne 20f
+ cmp 16,d1
+ bcc 20f
+ inc d1
+ mov d1,(32,sp)
+ bra 21f
+20:
+ mov d0,(40,sp)                   /* the new class (scratch) */
+ mov (28,sp),d0
+ asl 4,d0
+ add -1,d1
+ or d1,d0
+ XB_TOK
+ mov (40,sp),d0
+19:
+ mov d0,(28,sp)
+ mov 1,d0
+ mov d0,(32,sp)
+21:
+ mov (4,sp),d0
+ inc d0
+ mov d0,(4,sp)
+ cmp 70,d0
+ bne 11b
