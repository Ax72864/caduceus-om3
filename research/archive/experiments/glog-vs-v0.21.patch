+ * 1: chroma block (128 0x020003ff, 132 512, 144 0x151500, 148 0x04000400, 152 1024); 2: 1 + toning 84/88 = 0;
+ * 3: 1 + 92 = 0; 4: 1 + 108/112 = 0, 116 0x03ff03ff, 120 1023; 5: none (MONO). In 0x60504b2b's frame, a2 = context. */
+xb_h33:                           /* gl6: a forced capture (MONO request, context key 12) -> combiner 33 configured
